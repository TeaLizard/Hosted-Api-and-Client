## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
out/
artifacts/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ASP.NET / .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
Properties/launchSettings.json

# IIS Express
iisexpress/
*.vspscc
*.vssscc

# Logs
*.log
logs/
LogFiles/

# Generated files
Generated/
GeneratedFiles/

# Publish output
publish/
wwwroot/

# Resharper / Rider
.idea/
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
*.sln.iml

# VS Code
.vscode/
.history/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
*.nuget.props
*.nuget.targets

# Azure
*.azurePubxml
*.pubxml
*.publishsettings

# Entity Framework
Migrations/

# User secrets
secrets.json
**/appsettings.Development.json
**/appsettings.Local.json

# OS-specific
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~